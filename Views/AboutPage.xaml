<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" xmlns:m="clr-namespace:DiveHubMauiApp.Models" x:Class="DiveHubMauiApp.Views.AboutPage" x:DataType="vm:AboutViewModel" Title="About Dive Hub">
 <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="22" MaximumWidthRequest="1000" HorizontalOptions="Fill">
  <Image Source="divehub_logo.png" HeightRequest="90" HorizontalOptions="Start" Aspect="AspectFit" SemanticProperties.Description="Original Dive Hub Iskele logo"/>
  <Label Text="A MEDITERRANEAN STORY" Style="{StaticResource Eyebrow}"/><Label Text="More than a place to dive." Style="{StaticResource Title}"/>
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="240"><Image Source="center_panorama.jpg" Aspect="AspectFill" SemanticProperties.Description="Dive Hub coastal panorama from the original website"/></Border>
  <Label Text="{Binding About}" Style="{StaticResource Body}"/>
  <Label Text="People behind the story" Style="{StaticResource SectionTitle}"/>
  <Label Text="Names and roles as published on the archived team page. These do not establish current affiliations or qualifications." Style="{StaticResource Caption}"/>
  <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Team}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:TeamMember"><Border Style="{StaticResource Card}" Padding="16"><Grid ColumnDefinitions="86,*" ColumnSpacing="18"><Border StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="100" VerticalOptions="Start"><Image Source="{Binding Image}" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}"/></Border><VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center"><Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="19"/><Label Text="{Binding Role}" Style="{StaticResource Caption}"/></VerticalStackLayout></Grid></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  <Label Text="Sources &amp; preservation" Style="{StaticResource SectionTitle}"/>
  <Label Text="Rebuilt from the 2014 DiveHub Android Legacy project and the official Dive Hub website, retrieved 26 October 2026. Website descriptions take precedence where available. Dive Hub Shore and Amphora Beach are retained under their original names. The website labels the TDI overview as CMAS in one place; this collection uses the verified TDI detail pages." Style="{StaticResource Body}"/>
  <Label Text="All photographs and source descriptions remain attributed to their original Dive Hub sources. This app uses no online services. Personal dive records stay in local SQLite storage; uninstalling the app can remove them." Style="{StaticResource Caption}"/>
  <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>