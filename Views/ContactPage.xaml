<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" xmlns:m="clr-namespace:DiveHubMauiApp.Models" x:Class="DiveHubMauiApp.Views.ContactPage" x:DataType="vm:AboutViewModel" Title="Historical information">
 <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="22" MaximumWidthRequest="850" HorizontalOptions="Fill">
  <Label Text="PRESERVED FOR REFERENCE" Style="{StaticResource Eyebrow}"/><Label Text="A place in the archive." Style="{StaticResource Title}"/>
  <Label Text="The contact details below come from the 2014 Android application. Their current validity and the centre's operating status are unverified." Style="{StaticResource Body}"/>
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="200"><Image Source="center_panorama.jpg" Aspect="AspectFill"/></Border>
  <VerticalStackLayout BindableLayout.ItemsSource="{Binding Contacts}" Spacing="14"><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:ContactDetail"><Border Style="{StaticResource Card}" Padding="20"><VerticalStackLayout Spacing="10"><Label Text="{Binding Label}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Value}" FontSize="18"/><Button Text="Copy detail" Clicked="CopyClicked" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start"/></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
  <Label Text="{Binding Status}" TextColor="{StaticResource Ocean}"/><Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
  <Label Text="Copying a detail works offline. This app does not send messages, make calls or open the website." Style="{StaticResource Caption}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>