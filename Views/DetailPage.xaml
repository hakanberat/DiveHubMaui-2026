<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" x:Class="DiveHubMauiApp.Views.DetailPage" x:DataType="vm:DetailViewModel" Title="{Binding Entry.Name}">
 <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="22" MaximumWidthRequest="1000" HorizontalOptions="Fill">
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="{OnIdiom Phone=260, Default=360}"><Image Source="{Binding Entry.Image}" Aspect="AspectFill" SemanticProperties.Description="{Binding Entry.Name}"/></Border>
  <VerticalStackLayout Spacing="8">
   <Label Text="{Binding Entry.Eyebrow}" IsVisible="{Binding Entry.HasEyebrow}" Style="{StaticResource Eyebrow}"/>
   <Label Text="{Binding Entry.Name}" Style="{StaticResource Title}"/>
   <Label Text="{Binding Entry.Summary}" IsVisible="{Binding Entry.HasSummary}" Style="{StaticResource Body}"/>
  </VerticalStackLayout>
  <Grid IsVisible="{Binding Entry.HasSiteInfo}" ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="16">
   <VerticalStackLayout IsVisible="{Binding Entry.HasDepth}" Spacing="4"><Label Text="MAXIMUM SITE DEPTH" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Entry.DepthLabel}" FontSize="28" FontFamily="OpenSansSemibold"/></VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding Entry.HasAccess}" Grid.Column="1" Spacing="4"><Label Text="ACCESS" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Entry.Access}" FontSize="21"/></VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding Entry.HasExperience}" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"><Label Text="EXPERIENCE LEVEL" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Entry.Experience}" Style="{StaticResource Body}"/></VerticalStackLayout>
  </Grid>
  <Border IsVisible="{Binding Entry.HasCourseInfo}" Style="{StaticResource Card}" Padding="20"><VerticalStackLayout Spacing="12">
   <Label Text="COURSE INFORMATION" Style="{StaticResource Eyebrow}"/>
   <VerticalStackLayout IsVisible="{Binding Entry.HasMinimumAge}" Spacing="5"><Label Text="Minimum age" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Entry.MinimumAge}"/></VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding Entry.HasPrerequisites}" Spacing="5"><Label Text="Prerequisites" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Entry.Prerequisites}"/></VerticalStackLayout>
   <VerticalStackLayout IsVisible="{Binding Entry.HasDiveCount}" Spacing="5"><Label Text="Training dives" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Entry.DiveCount}"/></VerticalStackLayout>
  </VerticalStackLayout></Border>
  <VerticalStackLayout IsVisible="{Binding Entry.HasDescription}" Spacing="16">
   <Label Text="The story" Style="{StaticResource SectionTitle}"/>
   <Label Text="{Binding Entry.Description}" Style="{StaticResource Body}"/>
  </VerticalStackLayout>
  <Label Text="{Binding Entry.SourceNote}" IsVisible="{Binding Entry.HasNote}" FontSize="13" TextColor="{StaticResource Ocean}"/>
  <Button Text="Record a dive here  +" Command="{Binding LogDive}" IsVisible="{Binding Entry.IsSite}"/>
  <BoxView HeightRequest="1" Color="{StaticResource Line}"/>
  <Label Text="SOURCE" Style="{StaticResource Eyebrow}"/>
  <Label Text="{Binding Entry.Source}" Style="{StaticResource Caption}" LineBreakMode="CharacterWrap"/>
  <Button Text="Copy source address" Style="{StaticResource SecondaryButton}" Command="{Binding CopySource}" HorizontalOptions="Start"/>
  <Label Text="{Binding Status}" Style="{StaticResource Caption}"/><Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>
