<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" x:Class="DiveHubMauiApp.Views.DiveDetailPage" x:DataType="vm:DiveDetailViewModel" Title="Dive memory">
 <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="20" MaximumWidthRequest="850" HorizontalOptions="Fill">
  <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="28"><VerticalStackLayout Spacing="12"><Label Text="{Binding Dive.NumberLabel}" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Turquoise}"/><Label Text="{Binding Dive.DiveSite}" TextColor="White" FontSize="32" FontFamily="OpenSansSemibold"/><Label Text="{Binding Dive.DateLabel}" TextColor="#B8CDD9"/><Label Text="{Binding Dive.MetricsLabel}" TextColor="White" FontSize="23"/></VerticalStackLayout></Border>
  <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
  <Label Text="The details" Style="{StaticResource SectionTitle}"/>
  <Border Style="{StaticResource Card}" Padding="22"><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="20" ColumnSpacing="16">
   <VerticalStackLayout Spacing="5"><Label Text="STARTING PRESSURE" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.StartingPressure, StringFormat='{0} bar'}" FontSize="20"/></VerticalStackLayout>
   <VerticalStackLayout Grid.Column="1" Spacing="5"><Label Text="ENDING PRESSURE" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.EndingPressure, StringFormat='{0} bar'}" FontSize="20"/></VerticalStackLayout>
   <VerticalStackLayout Grid.Row="1" Spacing="5"><Label Text="EXPOSURE PROTECTION" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.ExposureProtection}"/></VerticalStackLayout>
   <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5"><Label Text="WEIGHT" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.Weight, StringFormat='{0:0.#} kg'}"/></VerticalStackLayout>
   <VerticalStackLayout Grid.Row="2" Spacing="5"><Label Text="DIVE LEADER" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.DiveLeader}"/></VerticalStackLayout>
   <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="5"><Label Text="DIVE BUDDY" Style="{StaticResource FieldLabel}"/><Label Text="{Binding Dive.DiveBuddy}"/></VerticalStackLayout>
  </Grid></Border>
  <Label Text="Notes &amp; memories" Style="{StaticResource SectionTitle}"/><Label Text="{Binding Dive.Notes}" Style="{StaticResource Body}"/>
  <Button Text="Edit this dive" Command="{Binding Edit}"/>
  <Button Text="Delete dive" Clicked="DeleteClicked" BackgroundColor="#FCEEF0" TextColor="{StaticResource Danger}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>