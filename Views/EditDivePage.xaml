<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" x:Class="DiveHubMauiApp.Views.EditDivePage" x:DataType="vm:EditDiveViewModel" Title="Dive editor" Shell.TabBarIsVisible="False">
 <ContentPage.ToolbarItems><ToolbarItem Text="Cancel" Clicked="CancelClicked"/></ContentPage.ToolbarItems>
 <Shell.BackButtonBehavior><BackButtonBehavior IsVisible="False"/></Shell.BackButtonBehavior>
 <ScrollView x:Name="FormScroll"><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="20" MaximumWidthRequest="760" HorizontalOptions="Fill">
  <Label Text="YOUR PERSONAL LOGBOOK" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Title}" Style="{StaticResource Title}"/>
  <Label Text="Site, date and the numerical dive details are required. Add the people and small details you want to remember." Style="{StaticResource Body}"/>
  <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
  <Label Text="01 / THE DIVE" Style="{StaticResource Eyebrow}"/>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="14"><VerticalStackLayout Spacing="6"><Label Text="Dive number" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Number}" Keyboard="Numeric" MaxLength="6" Placeholder="1" SemanticProperties.Description="Dive number"/></Border></VerticalStackLayout><ContentView Grid.Column="1"><VerticalStackLayout Spacing="6"><Label Text="Date" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><DatePicker Date="{Binding Date}" MaximumDate="{Binding Today}" MinimumDate="{Binding Earliest}" Format="dd MMM yyyy" SemanticProperties.Description="Dive date"/></Border></VerticalStackLayout></ContentView></Grid>
  <VerticalStackLayout Spacing="6"><Label Text="Dive site" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Site}" MaxLength="160" Placeholder="Where did you explore?" SemanticProperties.Description="Dive site"/></Border></VerticalStackLayout>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="14"><VerticalStackLayout Spacing="6"><Label Text="Maximum depth (m)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Depth}" Keyboard="Numeric" MaxLength="12" Placeholder="18.5" SemanticProperties.Description="Maximum depth (m)"/></Border></VerticalStackLayout><ContentView Grid.Column="1"><VerticalStackLayout Spacing="6"><Label Text="Duration (min)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Duration}" Keyboard="Numeric" MaxLength="4" Placeholder="45" SemanticProperties.Description="Duration (min)"/></Border></VerticalStackLayout></ContentView></Grid>
  <Label Text="02 / EQUIPMENT" Style="{StaticResource Eyebrow}"/>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="14"><VerticalStackLayout Spacing="6"><Label Text="Starting pressure (bar)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Start}" Keyboard="Numeric" MaxLength="3" Placeholder="200" SemanticProperties.Description="Starting pressure (bar)"/></Border></VerticalStackLayout><ContentView Grid.Column="1"><VerticalStackLayout Spacing="6"><Label Text="Ending pressure (bar)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding End}" Keyboard="Numeric" MaxLength="3" Placeholder="50" SemanticProperties.Description="Ending pressure (bar)"/></Border></VerticalStackLayout></ContentView></Grid>
  <VerticalStackLayout Spacing="6"><Label Text="Exposure protection (optional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Exposure}" MaxLength="120" Placeholder="e.g. 5 mm wetsuit" SemanticProperties.Description="Exposure protection (optional)"/></Border></VerticalStackLayout>
  <VerticalStackLayout Spacing="6"><Label Text="Weight carried (kg)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Weight}" Keyboard="Numeric" MaxLength="12" Placeholder="0" SemanticProperties.Description="Weight carried (kg)"/></Border></VerticalStackLayout>
  <Label Text="03 / THE PEOPLE &amp; THE MEMORY" Style="{StaticResource Eyebrow}"/>
  <VerticalStackLayout Spacing="6"><Label Text="Dive leader (optional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Leader}" MaxLength="120" Placeholder="Name" SemanticProperties.Description="Dive leader (optional)"/></Border></VerticalStackLayout>
  <VerticalStackLayout Spacing="6"><Label Text="Dive buddy (optional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10,2"><Entry Text="{Binding Buddy}" MaxLength="120" Placeholder="Name" SemanticProperties.Description="Dive buddy (optional)"/></Border></VerticalStackLayout>
  <VerticalStackLayout Spacing="6"><Label Text="Notes (optional)" Style="{StaticResource FieldLabel}"/><Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 12" Padding="10"><Editor Text="{Binding Notes}" Placeholder="The light, the life, the moment…" MaxLength="6000" AutoSize="TextChanges" MinimumHeightRequest="140" SemanticProperties.Description="Dive notes"/></Border></VerticalStackLayout>
  <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Ocean}"/>
  <Button Text="Save to my logbook" Command="{Binding Save}"/>
  <Button Text="Cancel" Clicked="CancelClicked" Style="{StaticResource SecondaryButton}"/>
  <Label Text="Stored locally on this device. No account or connection needed." Style="{StaticResource Caption}" HorizontalTextAlignment="Center"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>