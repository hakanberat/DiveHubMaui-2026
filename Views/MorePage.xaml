<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" xmlns:m="clr-namespace:DiveHubMauiApp.Models" xmlns:c="clr-namespace:DiveHubMauiApp.Components" x:Class="DiveHubMauiApp.Views.MorePage" x:DataType="vm:MoreViewModel" Title="Discover">
 <ScrollView><VerticalStackLayout Padding="{OnIdiom Phone='20,18,20,36', Default='36,24,36,40'}" Spacing="22" MaximumWidthRequest="1200" HorizontalOptions="Fill">
  <Label Text="THE PEOPLE. THE PLACE. THE STORIES." Style="{StaticResource Eyebrow}"/><Label Text="More than a dive." Style="{StaticResource Title}"/><Label Text="Discover the people, places and diving experiences of Dive Hub." Style="{StaticResource Body}"/>
  <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="220"><Grid><Image Source="center_panorama.jpg" Aspect="AspectFill"/><BoxView Color="#50081F32"/><VerticalStackLayout Padding="24" VerticalOptions="End" Spacing="8"><Label Text="A place by the sea." TextColor="White" FontSize="28" FontFamily="OpenSansSemibold"/><Label Text="Iskele Bogaz · Northern Cyprus" TextColor="White"/></VerticalStackLayout></Grid></Border>
  <Button Text="Photo gallery  →" Command="{Binding Open}" CommandParameter="gallery"/>
  <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="About &amp; team" Style="{StaticResource SecondaryButton}" Command="{Binding Open}" CommandParameter="about"/><Button Grid.Column="1" Text="Contact" Style="{StaticResource SecondaryButton}" Command="{Binding Open}" CommandParameter="contact"/></Grid>
  <Label Text="Diving experiences" Style="{StaticResource SectionTitle}"/>
  <FlexLayout x:Name="ServicesLayout" Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween" BindableLayout.ItemsSource="{Binding Services}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="m:ContentEntry"><c:ContentCard Invoked="EntryInvoked" FlexLayout.Basis="{OnIdiom Phone='100%', Default='48%'}"><c:ContentCard.GestureRecognizers><TapGestureRecognizer Tapped="EntryTapped"/></c:ContentCard.GestureRecognizers></c:ContentCard></DataTemplate></BindableLayout.ItemTemplate></FlexLayout>
  <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/>
 </VerticalStackLayout></ScrollView>
</ContentPage>