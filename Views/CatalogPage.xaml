<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DiveHubMauiApp.ViewModels" xmlns:m="clr-namespace:DiveHubMauiApp.Models" xmlns:c="clr-namespace:DiveHubMauiApp.Components" x:Class="DiveHubMauiApp.Views.CatalogPage" x:DataType="vm:CatalogViewModel" Title="Explore">
 <Grid Padding="{OnIdiom Phone='20,18,20,0', Default='36,24,36,0'}" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14" MaximumWidthRequest="1200" HorizontalOptions="Fill">
  <VerticalStackLayout Spacing="7"><Label Text="{Binding Eyebrow}" Style="{StaticResource Eyebrow}"/><Label Text="{Binding Title}" Style="{StaticResource Title}"/><Label Text="{Binding Subtitle}" Style="{StaticResource Body}"/><Label Text="Available offline" Style="{StaticResource Caption}"/></VerticalStackLayout>
  <Border Grid.Row="1" Style="{StaticResource Card}" StrokeShape="RoundRectangle 14"><SearchBar Text="{Binding Search}" Placeholder="Search your collection" SemanticProperties.Description="Search the offline collection"/></Border>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12"><Picker Title="Filter collection" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" SemanticProperties.Description="Filter collection"/><Button Grid.Column="1" Text="Reset" Style="{StaticResource LinkButton}" Command="{Binding Clear}"/></Grid>
  <VerticalStackLayout Grid.Row="3"><Label Text="{Binding CountLabel}" Style="{StaticResource Caption}"/><Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Error}"/></VerticalStackLayout>
  <CollectionView x:Name="Collection" Grid.Row="4" ItemsSource="{Binding Items}" SelectionMode="None" SizeChanged="CollectionSizeChanged">
   <CollectionView.ItemsLayout><GridItemsLayout x:Name="ItemsLayout" Orientation="Vertical" Span="1" HorizontalItemSpacing="18"/></CollectionView.ItemsLayout>
   <CollectionView.EmptyView><VerticalStackLayout Padding="24,40" Spacing="10"><Label Text="Nothing surfaced." Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center"/><Label Text="Try a different search or reset your filters." Style="{StaticResource Body}" HorizontalTextAlignment="Center"/></VerticalStackLayout></CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="m:ContentEntry"><c:ContentCard Invoked="EntryInvoked"><c:ContentCard.GestureRecognizers><TapGestureRecognizer Tapped="ItemTapped"/></c:ContentCard.GestureRecognizers></c:ContentCard></DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
